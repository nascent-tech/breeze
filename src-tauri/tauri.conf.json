{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Breeze",
  "version": "0.1.0",
  "identifier": "co.nascent-tech.breeze",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Breeze",
        "url": "panel.html",
        "width": 360,
        "height": 560,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "visible": false,
        "windowEffects": {
          "effects": ["popover"],
          "state": "active",
          "radius": 16
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
